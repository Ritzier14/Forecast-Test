<Window x:Class="ProjectCostForecast.App.TaskCategoryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ProjectCostForecast.App.Models"
        xmlns:local="clr-namespace:ProjectCostForecast.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Task and Category Editor"
        Width="860"
        Height="845"
        MinWidth="700"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="24"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:ProjectTaskIconConverter x:Key="ProjectTaskIconConverter" />
        <local:ProjectCategoryIconConverter x:Key="ProjectCategoryIconConverter" />
        <local:ProjectMetadataColorBrushConverter x:Key="ProjectMetadataColorBrushConverter" />
        <local:ProjectMetadataColorLabelConverter x:Key="ProjectMetadataColorLabelConverter" />

        <Style x:Key="RoundedActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D6E0EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorIconCellButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorColourPillButtonStyle" TargetType="Button" BasedOn="{StaticResource EditorIconCellButtonStyle}">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="MinHeight" Value="28" />
        </Style>

        <Style x:Key="EditorTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,3" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                            <Border x:Name="ActiveUnderline"
                                    Height="3"
                                    Background="{TemplateBinding BorderBrush}"
                                    VerticalAlignment="Bottom"
                                    Visibility="Visible" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#1E3A5F" />
                            </Trigger>
                            <Trigger Property="BorderBrush" Value="Transparent">
                                <Setter TargetName="ActiveUnderline" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5ECF4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="38" />
            <Setter Property="ColumnHeaderHeight" Value="44" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF3F8" />
            <Setter Property="VerticalGridLinesBrush" Value="#EEF3F8" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="Background" Value="{Binding Column.(models:GridColumnPresentationState.HeaderBackground), RelativeSource={RelativeSource Self}}" />
                        <Setter Property="BorderBrush" Value="{Binding Column.(models:GridColumnPresentationState.HeaderBorderBrush), RelativeSource={RelativeSource Self}}" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="Foreground" Value="#0F172A" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <EventSetter Event="PreviewMouseRightButtonUp" Handler="EditorColumnHeader_PreviewMouseRightButtonUp" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridColumnHeader">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                            <Border Width="18"
                                                    Height="18"
                                                    Margin="0,0,8,0"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#D6E2EF"
                                                    BorderThickness="1"
                                                    CornerRadius="5">
                                                <TextBlock Text="{Binding Column.(models:GridColumnPresentationState.IconGlyph), RelativeSource={RelativeSource TemplatedParent}}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="#64748B"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}" />
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="BorderBrush" Value="#EEF3F8" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          Margin="0" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DDEBFF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="BorderBrush" Value="#EEF3F8" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridRow">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <DataGridCellsPresenter />
                                            <Border x:Name="SelectedIndicator"
                                                    Width="4"
                                                    Background="Transparent"
                                                    HorizontalAlignment="Left"
                                                    IsHitTestVisible="False" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F8FBFF" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#EEF5FF" />
                                            <Setter TargetName="SelectedIndicator" Property="Background" Value="#2563EB" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorTextColumnDisplayStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="EditorTextColumnEditingStyle" TargetType="TextBox">
            <EventSetter Event="GotKeyboardFocus" Handler="EditorInlineTextBox_GotKeyboardFocus" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="EditorInlineTextBox_PreviewMouseLeftButtonDown" />
            <EventSetter Event="LostKeyboardFocus" Handler="EditorInlineTextBox_LostKeyboardFocus" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="CaretBrush" Value="#2563EB" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
    </Window.Resources>

    <Border Margin="18"
            Background="#F6F8FC"
            BorderBrush="#E5EAF3"
            BorderThickness="1"
            CornerRadius="24"
            Padding="26"
            PreviewMouseLeftButtonDown="WindowChrome_PreviewMouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18" MouseLeftButtonDown="WindowHeader_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42"
                            Height="42"
                            Background="#F5F8FF"
                            BorderBrush="#DCE6F7"
                            BorderThickness="1"
                            CornerRadius="12">
                        <TextBlock Text="TC"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#1F2937"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Task and Category Editor"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#111827" />
                        <TextBlock Text="Project task codes, task names, categories, icons, and colours"
                                   FontSize="13"
                                   Foreground="#64748B" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1"
                        Width="40"
                        Height="40"
                        Click="Cancel_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#374151"
                        FontSize="20"
                        Content="X"
                        ToolTip="Close" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Border Height="1"
                        Background="#DCE4EE"
                        VerticalAlignment="Bottom" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TaskCodesTabButton"
                            Content="Task Codes"
                            Tag="TaskCodes"
                            Click="EditorTabButton_Click"
                            Style="{StaticResource EditorTabButtonStyle}" />
                    <Button x:Name="CategoriesTabButton"
                            Content="Categories"
                            Tag="Categories"
                            Click="EditorTabButton_Click"
                            Style="{StaticResource EditorTabButtonStyle}" />
                </StackPanel>
            </Grid>

            <StackPanel x:Name="TaskCodesToolbar" Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Add above" Style="{StaticResource RoundedActionButtonStyle}" Click="AddTaskAbove_Click" />
                <Button Content="Add below" Style="{StaticResource RoundedActionButtonStyle}" Click="AddTaskBelow_Click" />
                <Button Content="Delete" Style="{StaticResource RoundedActionButtonStyle}" Click="DeleteTask_Click" />
                <Button Content="A-Z sort" Style="{StaticResource RoundedActionButtonStyle}" Click="SortTasks_Click" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#64748B"
                           Text="Imported means this task code came from raw imported data, so the code itself stays locked." />
            </StackPanel>

            <StackPanel x:Name="CategoriesToolbar" Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
                <Button Content="Add" Style="{StaticResource RoundedActionButtonStyle}" Click="AddCategory_Click" />
                <Button Content="Delete" Style="{StaticResource RoundedActionButtonStyle}" Click="DeleteCategory_Click" />
                <ComboBox x:Name="MergeTargetCombo"
                          ItemsSource="{Binding ProjectCategories}"
                          DisplayMemberPath="Name"
                          Width="220"
                          Height="36"
                          Margin="0,0,10,0"
                          VerticalContentAlignment="Center" />
                <Button Content="Merge into" Style="{StaticResource RoundedActionButtonStyle}" Click="MergeCategory_Click" />
                <Button Content="A-Z sort" Style="{StaticResource RoundedActionButtonStyle}" Click="SortCategories_Click" />
            </StackPanel>

            <Grid Grid.Row="3">
                <Border x:Name="TaskCodesPanel"
                        Background="White"
                        BorderBrush="#E5ECF4"
                        BorderThickness="1"
                        CornerRadius="18"
                        SizeChanged="RoundedGridHost_SizeChanged"
                        Padding="0">
                    <local:ProjectDataGrid x:Name="TaskCodesGrid"
                              Style="{StaticResource EditorDataGridStyle}"
                              ItemsSource="{Binding ProjectTaskCodes}"
                              AutoGenerateColumns="False"
                              BeginningEdit="TaskCodesGrid_BeginningEdit"
                              PreviewMouseLeftButtonDown="EditorGrid_PreviewMouseLeftButtonDown"
                              PreviewMouseRightButtonDown="EditorGrid_PreviewMouseRightButtonDown"
                              PreviewMouseRightButtonUp="EditorGrid_PreviewMouseRightButtonUp"
                              MouseMove="TaskCodesGrid_MouseMove"
                              PreviewMouseMove="EditorGrid_PreviewMouseMove"
                              Drop="TaskCodesGrid_Drop"
                              AllowDrop="True"
                              PreviewTextInput="EditorGrid_PreviewTextInput"
                              PreviewKeyDown="EditorGrid_PreviewKeyDown"
                              MouseDoubleClick="EditorGrid_MouseDoubleClick"
                              Margin="-1,0,-1,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Task code"
                                                models:GridColumnPresentationState.IconGlyph="T"
                                                Binding="{Binding SystemCode, UpdateSourceTrigger=PropertyChanged}"
                                                Width="128"
                                                ElementStyle="{StaticResource EditorTextColumnDisplayStyle}"
                                                EditingElementStyle="{StaticResource EditorTextColumnEditingStyle}" />
                            <DataGridTemplateColumn Header="Task name"
                                                    models:GridColumnPresentationState.IconGlyph="T"
                                                    Width="*"
                                                    SortMemberPath="TaskName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type models:ProjectTaskCode}">
                                        <TextBox Text="{Binding TaskName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditorTextColumnEditingStyle}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate DataType="{x:Type models:ProjectTaskCode}">
                                        <TextBox Text="{Binding TaskName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditorTextColumnEditingStyle}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Imported" Width="112.67" IsReadOnly="True"
                                                    models:GridColumnPresentationState.IconGlyph="✓">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type models:ProjectTaskCode}">
                                        <Grid Height="38"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center">
                                            <Border Width="16"
                                                    Height="16"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#64748B"
                                                    BorderThickness="1.4"
                                                    SnapsToDevicePixels="True">
                                                <Path Data="M 3 8 L 6.8 11.8 L 13 4"
                                                      Stroke="#111827"
                                                      StrokeThickness="2"
                                                      StrokeEndLineCap="Square"
                                                      StrokeStartLineCap="Square"
                                                      Visibility="{Binding IsRawDataCode, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Icon" Width="75.33"
                                                    models:GridColumnPresentationState.IconGlyph="I">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type models:ProjectTaskCode}">
                                        <Grid Height="38"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center">
                                            <Button Tag="{Binding}"
                                                    Click="TaskIconButton_Click"
                                                    Style="{StaticResource EditorIconCellButtonStyle}">
                                                <Border Width="22"
                                                        Height="22"
                                                        Background="#F8FBFF"
                                                        BorderBrush="#D8E4F4"
                                                        BorderThickness="1"
                                                        CornerRadius="7">
                                                    <Image Width="20"
                                                           Height="20"
                                                           Stretch="Uniform"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                        <Image.Source>
                                                            <MultiBinding Converter="{StaticResource ProjectTaskIconConverter}">
                                                                <Binding Path="IconKey" />
                                                                <Binding Path="IconColorHex" />
                                                            </MultiBinding>
                                                        </Image.Source>
                                                    </Image>
                                                </Border>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Colour" Width="130"
                                                    models:GridColumnPresentationState.IconGlyph="C">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type models:ProjectTaskCode}">
                                        <Grid Height="38"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center">
                                            <Button Tag="{Binding}"
                                                    Click="TaskColourButton_Click"
                                                    PreviewMouseRightButtonUp="TaskColourButton_PreviewMouseRightButtonUp"
                                                    Style="{StaticResource EditorColourPillButtonStyle}">
                                                <Border Width="108"
                                                        Height="28"
                                                        CornerRadius="14"
                                                        BorderBrush="#CBD5E1"
                                                        BorderThickness="1">
                                                    <Border.Background>
                                                        <MultiBinding Converter="{StaticResource ProjectMetadataColorBrushConverter}">
                                                            <Binding Path="HeaderColorHex" />
                                                            <Binding Path="DefaultHeaderColorHex" />
                                                        </MultiBinding>
                                                    </Border.Background>
                                                    <TextBlock Foreground="#1E293B"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource ProjectMetadataColorLabelConverter}">
                                                                <Binding Path="HeaderColorHex" />
                                                                <Binding Path="DefaultHeaderColorHex" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Border>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </local:ProjectDataGrid>
                </Border>

                <Border x:Name="CategoriesPanel"
                        Background="White"
                        BorderBrush="#E5ECF4"
                        BorderThickness="1"
                        CornerRadius="18"
                        SizeChanged="RoundedGridHost_SizeChanged"
                        Padding="0"
                        Visibility="Collapsed">
                    <local:ProjectDataGrid x:Name="CategoriesGrid"
                              Style="{StaticResource EditorDataGridStyle}"
                              ItemsSource="{Binding ProjectCategories}"
                              AutoGenerateColumns="False"
                              PreviewMouseRightButtonDown="EditorGrid_PreviewMouseRightButtonDown"
                              PreviewMouseRightButtonUp="EditorGrid_PreviewMouseRightButtonUp"
                              PreviewMouseMove="EditorGrid_PreviewMouseMove"
                              PreviewTextInput="EditorGrid_PreviewTextInput"
                              PreviewKeyDown="EditorGrid_PreviewKeyDown"
                              PreviewMouseLeftButtonDown="EditorGrid_PreviewMouseLeftButtonDown"
                              MouseDoubleClick="EditorGrid_MouseDoubleClick"
                              Margin="-1,0,-1,0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Category"
                                                    models:GridColumnPresentationState.IconGlyph="T"
                                                    Width="*"
                                                    SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type models:ProjectCategory}">
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditorTextColumnEditingStyle}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate DataType="{x:Type models:ProjectCategory}">
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditorTextColumnEditingStyle}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Icon" Width="120"
                                                    models:GridColumnPresentationState.IconGlyph="I">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type models:ProjectCategory}">
                                        <Grid Height="38"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center">
                                            <Button Tag="{Binding}"
                                                    Click="CategoryIconButton_Click"
                                                    Style="{StaticResource EditorIconCellButtonStyle}">
                                                <Border Width="22"
                                                        Height="22"
                                                        Background="#F8FBFF"
                                                        BorderBrush="#D8E4F4"
                                                        BorderThickness="1"
                                                        CornerRadius="7">
                                                    <Image Source="{Binding IconKey, Converter={StaticResource ProjectCategoryIconConverter}}"
                                                           Width="20"
                                                           Height="20"
                                                           Stretch="Uniform"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                </Border>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Colour" Width="140"
                                                    models:GridColumnPresentationState.IconGlyph="C">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type models:ProjectCategory}">
                                        <Grid Height="38"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center">
                                            <Button Tag="{Binding}"
                                                    Click="CategoryColourButton_Click"
                                                    PreviewMouseRightButtonUp="CategoryColourButton_PreviewMouseRightButtonUp"
                                                    Style="{StaticResource EditorColourPillButtonStyle}">
                                                <Border Width="108"
                                                        Height="28"
                                                        CornerRadius="14"
                                                        BorderBrush="#CBD5E1"
                                                        BorderThickness="1">
                                                    <Border.Background>
                                                        <MultiBinding Converter="{StaticResource ProjectMetadataColorBrushConverter}">
                                                            <Binding Path="ColorHex" />
                                                            <Binding Path="DefaultColorHex" />
                                                        </MultiBinding>
                                                    </Border.Background>
                                                    <TextBlock Foreground="#1E293B"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource ProjectMetadataColorLabelConverter}">
                                                                <Binding Path="ColorHex" />
                                                                <Binding Path="DefaultColorHex" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Border>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </local:ProjectDataGrid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Style="{StaticResource RoundedActionButtonStyle}" Click="Cancel_Click" />
                <Button Content="Save" Style="{StaticResource RoundedActionButtonStyle}" Click="Save_Click" />
                <ResizeGrip Width="16"
                            Height="16"
                            Margin="8,0,0,0"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
